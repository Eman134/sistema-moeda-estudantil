# Copie para .env (não commite o .env) ou configure no IntelliJ / variáveis do sistema.
SPRING_PROFILES_ACTIVE=brevo

# Brevo SMTP — painel: https://app.brevo.com/settings/keys/smtp
# Servidor: smtp-relay.brevo.com | Porta: 587
# Login SMTP: formato xxxxx@smtp-brevo.com (NÃO é sua senha da conta)
BREVO_SMTP_LOGIN=seu-id@smtp-brevo.com
# Chave SMTP: clique em "Gerar" no painel e cole aqui (não compartilhe)
BREVO_SMTP_KEY=

# Remetente verificado em https://app.brevo.com/senders (pode ser seu e-mail pessoal)
BREVO_MAIL_FROM=

BREVO_ENABLED=true
MAIL_ENABLED=true

DB_PASSWORD=
JWT_SECRET=
